function AnimatedNumber({ end, decimals = 0, prefix = "", suffix = "", color }) {
  const [val, setVal] = useState(0);
  const ref = useRef(null);
  const started = useRef(false);

  useEffect(() => {
    const obs = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !started.current) {
          started.current = true;
          const numEnd = parseFloat(end);
          let cur = 0;
          const step = numEnd / 60;
          const iv = setInterval(() => {
            cur += step;
            if (cur >= numEnd) { setVal(numEnd); clearInterval(iv); }
            else setVal(cur);
          }, 16);
        }
      },
      { threshold: 0.4 }
    );
    if (ref.current) obs.observe(ref.current);
    return () => obs.disconnect();
  }, [end]);

  return (
    <span ref={ref} style={{ color, fontFamily: font.mono, fontWeight: 700 }}>
      {prefix}{val.toFixed(decimals)}{suffix}
    </span>
  );
}

