          <div id="about-right" data-observe className={`fade-in-section ${visibleSections["about-right"] ? "visible" : ""}`} style={{ transitionDelay: "0.2s" }}>
            <div style={{ background: "#111", padding: "48px", borderTop: `2px solid ${gold}` }}>
              <div style={{ fontSize: "11px", letterSpacing: "3px", textTransform: "uppercase", color: gold, fontFamily: "'Outfit', sans-serif", marginBottom: "28px" }}>Metodoloji</div>
              {[{ title: "Klinik Değerlendirme", desc: "Her ürün fizyolojik mekanizması açısından değerlendirilir." }, { title: "Literatür Taraması", desc: "PubMed ve Cochrane veri tabanlarındaki güncel kanıtlar analiz edilir." }, { title: "Tarafsız İnceleme", desc: "Hiçbir sponsorlu içerik yayınlanmaz. Editoryal bağımsızlık korunur." }].map((item, i) => (
                <div key={item.title} style={{ marginBottom: "28px", paddingBottom: "28px", borderBottom: i < 2 ? "1px solid rgba(255,255,255,0.05)" : "none" }}>
                  <div style={{ fontSize: "16px", fontWeight: 600, marginBottom: "8px", color: "#E8E0D5" }}>{item.title}</div>
                  <div style={{ fontSize: "13px", color: "#5A5248", fontFamily: "'Outfit', sans-serif", fontWeight: 300, lineHeight: 1.6 }}>{item.desc}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </>
  );
}

// ─── BLOG PAGE ────────────────────────────────────────────────────────────────

function BlogPage({ setPage }) {
  const [activeCategory, setActiveCategory] = useState("Tümü");
  const [selectedPost, setSelectedPost] = useState(null);
  const [visiblePosts, setVisiblePosts] = useState({});

  useEffect(() => {
    window.scrollTo(0, 0);
  }, [selectedPost]);

  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) setVisiblePosts((p) => ({ ...p, [e.target.id]: true }));
      }),
      { threshold: 0.1 }
    );
    document.querySelectorAll("[data-blog-observe]").forEach((el) => observer.observe(el));
    return () => observer.disconnect();
  }, [activeCategory, selectedPost]);

  const gold = "#C8A96E";
  const filtered = activeCategory === "Tümü" ? BLOG_POSTS : BLOG_POSTS.filter((p) => p.category === activeCategory);
  const featured = BLOG_POSTS.find((p) => p.featured);

  // ── SINGLE POST VIEW ──
  if (selectedPost) {
    return (
      <div style={{ minHeight: "100vh", background: "#0A0A0A", paddingTop: "120px" }}>
        <div style={{ maxWidth: "760px", margin: "0 auto", padding: "0 48px 100px" }}>
          <button onClick={() => setSelectedPost(null)} style={{ display: "flex", alignItems: "center", gap: "10px", background: "none", border: "none", cursor: "pointer", color: "#5A5248", fontFamily: "'Outfit', sans-serif", fontSize: "12px", letterSpacing: "2px", textTransform: "uppercase", marginBottom: "48px", padding: 0 }}>
            ← Bloga Dön
          </button>
          <div style={{ fontSize: "10px", letterSpacing: "3px", textTransform: "uppercase", color: gold, fontFamily: "'Outfit', sans-serif", marginBottom: "20px" }}>
            {selectedPost.category}
          </div>
          <h1 style={{ fontSize: "clamp(32px, 4vw, 52px)", fontWeight: 300, lineHeight: 1.15, color: "#E8E0D5", marginBottom: "24px" }}>
            {selectedPost.title}
          </h1>
          <div style={{ display: "flex", gap: "24px", marginBottom: "56px", paddingBottom: "32px", borderBottom: "1px solid rgba(200,169,110,0.15)" }}>
            <span style={{ fontSize: "12px", color: "#5A5248", fontFamily: "'Outfit', sans-serif" }}>{selectedPost.date}</span>
            <span style={{ fontSize: "12px", color: "#5A5248", fontFamily: "'Outfit', sans-serif" }}>{selectedPost.readTime} okuma</span>
          </div>
          <div style={{ fontSize: "17px", color: "#B0A898", lineHeight: 1.9, fontFamily: "'Outfit', sans-serif", fontWeight: 300 }}>
            {selectedPost.content.split("\n\n").map((paragraph, i) => {
              if (paragraph.startsWith("**") && paragraph.endsWith("**")) {
                return <h3 key={i} style={{ fontSize: "22px", fontWeight: 600, color: "#E8E0D5", fontFamily: "'Cormorant Garamond', Georgia, serif", marginTop: "40px", marginBottom: "16px" }}>{paragraph.replace(/\*\*/g, "")}</h3>;
              }
              if (paragraph.includes("**")) {
                const parts = paragraph.split("**");
                return (
                  <p key={i} style={{ marginBottom: "24px" }}>
                    {parts.map((part, j) => j % 2 === 1 ? <strong key={j} style={{ color: "#E8E0D5", fontWeight: 600 }}>{part}</strong> : part)}
                  </p>
                );
              }
              return <p key={i} style={{ marginBottom: "24px" }}>{paragraph}</p>;
            })}
          </div>
          <div style={{ marginTop: "64px", paddingTop: "40px", borderTop: "1px solid rgba(200,169,110,0.15)", display: "flex", alignItems: "center", gap: "16px" }}>
            <div style={{ width: "48px", height: "48px", borderRadius: "50%", background: "#1A1A1A", border: `1px solid ${gold}`, display: "flex", alignItems: "center", justifyContent: "center" }}>
              <span style={{ color: gold, fontSize: "18px", fontFamily: "'Cormorant Garamond', serif", fontStyle: "italic" }}>A</span>
            </div>
            <div>
              <div style={{ fontSize: "14px", fontWeight: 600, color: "#E8E0D5", fontFamily: "'Outfit', sans-serif" }}>Alfamentor Editörü</div>
              <div style={{ fontSize: "12px", color: "#5A5248", fontFamily: "'Outfit', sans-serif" }}>Anesteziyoloji & Reanimasyon Uzmanı</div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // ── BLOG LIST VIEW ──
  return (
    <div style={{ minHeight: "100vh", background: "#0A0A0A", paddingTop: "120px" }}>
      {/* Header */}
      <div style={{ padding: "40px 48px 80px", maxWidth: "1200px", margin: "0 auto" }}>
        <div style={{ display: "flex", alignItems: "center", gap: "12px", marginBottom: "20px" }}>
          <div style={{ width: "30px", height: "1px", background: gold }} />
          <span style={{ fontSize: "10px", letterSpacing: "4px", textTransform: "uppercase", color: gold, fontFamily: "'Outfit', sans-serif" }}>Kanıta Dayalı İçerik</span>
        </div>
        <h1 style={{ fontSize: "clamp(40px, 6vw, 80px)", fontWeight: 300, lineHeight: 1.05, color: "#E8E0D5" }}>
          Bilimsel <span style={{ fontWeight: 700, fontStyle: "italic", color: gold }}>Blog</span>
        </h1>
      </div>

      {/* Featured Post */}
      {featured && (
        <div style={{ padding: "0 48px 80px", maxWidth: "1200px", margin: "0 auto" }}>
          <div
            onClick={() => setSelectedPost(featured)}
            style={{ background: "#111", padding: "56px", borderTop: `2px solid ${gold}`, cursor: "pointer", display: "grid", gridTemplateColumns: "1fr auto", gap: "40px", alignItems: "center", transition: "background 0.3s" }}
            className="featured-card"
          >
            <div>
              <div style={{ fontSize: "9px", letterSpacing: "3px", textTransform: "uppercase", background: `${gold}20`, color: gold, padding: "4px 12px", display: "inline-block", marginBottom: "24px", fontFamily: "'Outfit', sans-serif", fontWeight: 700 }}>
                ÖNE ÇIKAN YAZI
              </div>
              <h2 style={{ fontSize: "clamp(24px, 3vw, 38px)", fontWeight: 300, lineHeight: 1.2, color: "#E8E0D5", marginBottom: "16px" }}>
                {featured.title}
              </h2>
              <p style={{ fontSize: "15px", color: "#7A7268", lineHeight: 1.7, fontFamily: "'Outfit', sans-serif", fontWeight: 300, maxWidth: "560px", marginBottom: "28px" }}>
                {featured.excerpt}
              </p>
              <div style={{ display: "flex", gap: "24px" }}>
                <span style={{ fontSize: "11px", color: "#5A5248", fontFamily: "'Outfit', sans-serif", letterSpacing: "1px" }}>{featured.date}</span>
                <span style={{ fontSize: "11px", color: "#5A5248", fontFamily: "'Outfit', sans-serif", letterSpacing: "1px" }}>{featured.readTime} okuma</span>
                <span style={{ fontSize: "11px", color: gold, fontFamily: "'Outfit', sans-serif", letterSpacing: "1px" }}>{featured.category}</span>
              </div>
            </div>
            <div style={{ fontSize: "48px", color: "#2A2520", transition: "all 0.3s ease" }} className="blog-arrow">→</div>
          </div>
        </div>
      )}

      {/* Category Filter */}
      <div style={{ padding: "0 48px 48px", maxWidth: "1200px", margin: "0 auto" }}>
        <div style={{ display: "flex", gap: "4px", flexWrap: "wrap" }}>
          {CATEGORIES.map((cat) => (
            <button
              key={cat}
              onClick={() => setActiveCategory(cat)}
              style={{
                padding: "10px 20px", fontSize: "11px", letterSpacing: "2px", textTransform: "uppercase",
                fontFamily: "'Outfit', sans-serif", fontWeight: activeCategory === cat ? 600 : 400,
                background: activeCategory === cat ? gold : "transparent",
                color: activeCategory === cat ? "#0A0A0A" : "#5A5248",
                border: activeCategory === cat ? "none" : "1px solid rgba(255,255,255,0.08)",
                cursor: "pointer", transition: "all 0.2s ease",
              }}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      {/* Post Grid */}
      <div style={{ padding: "0 48px 100px", maxWidth: "1200px", margin: "0 auto" }}>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(340px, 1fr))", gap: "2px" }}>
          {filtered.filter((p) => !p.featured || activeCategory !== "Tümü").map((post, i) => (
            <div
              key={post.id}
              id={`blog-${post.id}`}
              data-blog-observe
              className={`fade-in-section blog-card ${visiblePosts[`blog-${post.id}`] ? "visible" : ""}`}
              onClick={() => setSelectedPost(post)}
              style={{ background: "#111", padding: "40px", cursor: "pointer", borderTop: "1px solid rgba(200,169,110,0.1)", transition: "all 0.3s ease", transitionDelay: `${i * 0.08}s` }}
            >
              <div style={{ fontSize: "9px", letterSpacing: "2px", textTransform: "uppercase", color: gold, fontFamily: "'Outfit', sans-serif", fontWeight: 600, marginBottom: "20px" }}>
                {post.category}
              </div>
              <h3 style={{ fontSize: "20px", fontWeight: 500, lineHeight: 1.3, color: "#E8E0D5", marginBottom: "14px" }}>
                {post.title}
              </h3>
              <p style={{ fontSize: "13px", color: "#5A5248", lineHeight: 1.7, fontFamily: "'Outfit', sans-serif", fontWeight: 300, marginBottom: "28px" }}>
                {post.excerpt}
              </p>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", paddingTop: "20px", borderTop: "1px solid rgba(255,255,255,0.05)" }}>
                <div style={{ display: "flex", gap: "16px" }}>
                  <span style={{ fontSize: "10px", color: "#3A3530", fontFamily: "'Outfit', sans-serif", letterSpacing: "1px" }}>{post.date}</span>
                  <span style={{ fontSize: "10px", color: "#3A3530", fontFamily: "'Outfit', sans-serif", letterSpacing: "1px" }}>{post.readTime}</span>
                </div>
                <span style={{ color: "#2A2520", fontSize: "18px", transition: "all 0.3s ease" }} className="card-arrow">→</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

