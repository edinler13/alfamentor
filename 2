      </div>
    </footer>
  );
}

// ─── APP ──────────────────────────────────────────────────────────────────────

export default function App() {
  const [page, setPage] = useState("home");
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    const handleScroll = () => setScrolled(window.scrollY > 60);
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    window.scrollTo(0, 0);
  }, [page]);

  return (
    <>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,600;1,700&family=Outfit:wght@300;400;500;600;700&display=swap');
        * { margin: 0; padding: 0; box-sizing: border-box; }

        @keyframes fadeInUp {
          from { opacity: 0; transform: translateY(40px); }
          to { opacity: 1; transform: translateY(0); }
        }

        body { background: #0A0A0A; }

        .fade-in-section { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
        .fade-in-section.visible { opacity: 1; transform: translateY(0); }

        .product-card:hover { background: #161616 !important; transform: translateY(-4px); }
        .product-card:hover .product-accent-line { width: 100% !important; }

        .blog-card:hover { background: #161616 !important; }
        .blog-card:hover .card-arrow { color: #C8A96E !important; transform: translateX(6px); }

        .featured-card:hover { background: #161616 !important; }
        .featured-card:hover .blog-arrow { color: #C8A96E !important; transform: translateX(8px); }

        a { color: inherit; }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #0A0A0A; }
        ::-webkit-scrollbar-thumb { background: #C8A96E; }
      `}</style>

      <div style={{ fontFamily: "'Cormorant Garamond', Georgia, serif", background: "#0A0A0A", color: "#E8E0D5", minHeight: "100vh" }}>
        <Navbar page={page} setPage={setPage} scrolled={scrolled} />
        {page === "home" ? <HomePage setPage={setPage} /> : <BlogPage setPage={setPage} />}
        <Footer setPage={setPage} />
      </div>
    </>
  );
}
